# ----- fuzzing ----------------------------------------------------

# libFuzzer targets for the parsers of input from outside the host, built
# with clang from the util sources under ASan and UBSan; make -C testing
# fuzz builds and runs them.
FUZZ_CC ?= clang
FUZZ_CFLAGS := -O1 -g -std=gnu11 -fno-omit-frame-pointer \
               -fsanitize=fuzzer,address,undefined \
               -fno-sanitize-recover=all $(WARNINGS) \
               -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE $(INCLUDES) \
               $(LIBCRYPTO_CFLAGS) $(LIBCURL_CFLAGS) $(ZLIB_CFLAGS)
FUZZ_LIBS := $(LIBCRYPTO_LIBS) $(LIBSSL_LIBS) $(LIBCURL_LIBS) $(ZLIB_LIBS)
FUZZ_BASE := util/json.c util/string.c util/hex.c util/malloc.c \
             testing/fuzz/log.c
FUZZ_CONFIG := util/config.c util/image_config.c
FUZZ_SEAL := util/seal.c $(FUZZ_CONFIG)
FUZZ_OCI := util/bpm_oci.c util/io.c $(FUZZ_SEAL) util/crypto_openssl.c \
            util/tls_openssl.c
FUZZ_PACKAGE := util/bpm_package.c util/bpm_tree.c $(FUZZ_OCI)

FUZZ_TARGETS := $(patsubst %.c,%,$(wildcard testing/fuzz/fuzz-*.c))

testing/fuzz/fuzz-json: testing/fuzz/fuzz-json.c $(FUZZ_BASE)
testing/fuzz/fuzz-oci-manifest: testing/fuzz/fuzz-oci-manifest.c \
                                $(FUZZ_BASE) $(FUZZ_OCI)
testing/fuzz/fuzz-bpm-index: testing/fuzz/fuzz-bpm-index.c \
                             $(FUZZ_BASE) $(FUZZ_PACKAGE)
testing/fuzz/fuzz-tree: testing/fuzz/fuzz-tree.c $(FUZZ_BASE) \
                        util/bpm_tree.c util/crypto_openssl.c util/io.c \
                        $(FUZZ_SEAL)
testing/fuzz/fuzz-upatch: testing/fuzz/fuzz-upatch.c $(FUZZ_BASE) \
                          util/upatch.c
testing/fuzz/fuzz-prog-metadata: testing/fuzz/fuzz-prog-metadata.c \
                                 $(FUZZ_BASE) util/upatch.c
testing/fuzz/fuzz-bpm-tar: testing/fuzz/fuzz-bpm-tar.c $(FUZZ_BASE) \
                           $(FUZZ_PACKAGE)
testing/fuzz/fuzz-bpm-package: testing/fuzz/fuzz-bpm-package.c $(FUZZ_BASE) \
                               $(FUZZ_PACKAGE)
testing/fuzz/fuzz-tpm-wire: testing/fuzz/fuzz-tpm-wire.c $(FUZZ_BASE) \
                            util/tpm_wire.c util/crypto_openssl.c util/io.c \
                            $(FUZZ_SEAL)
testing/fuzz/fuzz-attest: testing/fuzz/fuzz-attest.c $(FUZZ_BASE) \
                          util/attest.c util/chain.c util/nv_writer.c util/tpm.c \
                          util/tpm_wire.c util/eventlog.c util/timefmt.c \
                          util/crypto_openssl.c util/io.c $(FUZZ_SEAL) \
                          util/config_attest.c util/config_update.c \
                          util/config_measure.c util/initrd.c util/identity.c \
                          util/keyring.c util/version_id.c $(LIBBPF_A)
testing/fuzz/fuzz-attest: FUZZ_CFLAGS += $(TSS2_CFLAGS) $(LIBELF_CFLAGS)
testing/fuzz/fuzz-attest: FUZZ_LIBS += $(TSS2_LIBS) $(LIBBPF_A) $(LIBELF_LIBS) $(ZLIB_LIBS)
testing/fuzz/fuzz-eventlog: testing/fuzz/fuzz-eventlog.c $(FUZZ_BASE) \
                            util/eventlog.c util/timefmt.c $(FUZZ_SEAL) \
                            util/io.c util/crypto_openssl.c testing/fuzz/chain.c
testing/fuzz/fuzz-kernel: testing/fuzz/fuzz-kernel.c $(FUZZ_BASE) \
                          util/kmsg.c util/kmodules.c util/kernel_build_id.c \
                          util/format.c util/timefmt.c
testing/fuzz/fuzz-elf: testing/fuzz/fuzz-elf.c $(FUZZ_BASE) \
                       util/elf_target.c $(LIBBPF_A)
testing/fuzz/fuzz-elf: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
testing/fuzz/fuzz-elf: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS)
testing/fuzz/fuzz-serializer: testing/fuzz/fuzz-serializer.c $(FUZZ_BASE) \
                              util/upatch_maps.c util/upatch_resolve.c \
                              util/serializer.c $(FUZZ_SEAL) util/io.c \
                              util/timefmt.c $(LIBBPF_A)
testing/fuzz/fuzz-serializer: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
testing/fuzz/fuzz-serializer: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS)
testing/fuzz/fuzz-cms: testing/fuzz/fuzz-cms.c $(FUZZ_BASE) util/keys.c \
                       util/crypto_openssl.c util/io.c $(FUZZ_SEAL)
testing/fuzz/fuzz-decoder: testing/fuzz/fuzz-decoder.c $(FUZZ_BASE) \
                           util/upatch_decode.c util/upatch.c util/io.c \
                           $(FUZZ_SEAL)
testing/fuzz/fuzz-decoder: FUZZ_CFLAGS += $(LUAJIT_CFLAGS) -DSHIRUDO_HAVE_LUAJIT
testing/fuzz/fuzz-decoder: FUZZ_LIBS += $(LUAJIT_LIBS)
testing/fuzz/fuzz-otel: testing/fuzz/fuzz-otel.c $(FUZZ_BASE) \
                        util/upatch_maps_otel.c util/crypto_openssl.c \
                        util/tls_openssl.c util/io.c util/version_id.c \
                        $(FUZZ_SEAL)
testing/fuzz/fuzz-beefile: testing/fuzz/fuzz-beefile.c $(FUZZ_BASE) \
                           tools/shirudo-build/bpm-build.c $(FUZZ_PACKAGE) \
                           util/upatch.c util/timefmt.c util/paths.c \
                           util/version_id.c
testing/fuzz/fuzz-oci-http: testing/fuzz/fuzz-oci-http.c $(FUZZ_BASE) \
                            $(FUZZ_OCI)
testing/fuzz/fuzz-oci-ref: testing/fuzz/fuzz-oci-ref.c $(FUZZ_BASE) \
                           $(FUZZ_OCI)
testing/fuzz/fuzz-registry-auth: testing/fuzz/fuzz-registry-auth.c \
                                 $(FUZZ_BASE) $(FUZZ_OCI)
testing/fuzz/fuzz-config: testing/fuzz/fuzz-config.c $(FUZZ_BASE) \
                          $(FUZZ_CONFIG) util/seal.c util/io.c \
                          util/bpm_source_config.c
FUZZ_TREE_STATE := util/bpm_tree_state.c util/io.c $(FUZZ_SEAL) \
                   util/kernel_build_id.c util/kernel_release.c \
                   util/crypto_openssl.c testing/fuzz/chain.c
testing/fuzz/fuzz-tree-state: testing/fuzz/fuzz-tree-state.c $(FUZZ_BASE) \
                              $(FUZZ_TREE_STATE)
testing/fuzz/fuzz-kconfig: testing/fuzz/fuzz-kconfig.c $(FUZZ_BASE) \
                           $(FUZZ_TREE_STATE)

# A target that reaches static parsers includes their source, which it
# then depends on without linking it a second time.
testing/fuzz/fuzz-oci-http: FUZZ_INCLUDED := util/bpm_oci.c
testing/fuzz/fuzz-tree-state testing/fuzz/fuzz-kconfig: \
	FUZZ_INCLUDED := util/bpm_tree_state.c
testing/fuzz/fuzz-otel: FUZZ_INCLUDED := util/upatch_maps_otel.c
testing/fuzz/fuzz-kernel: FUZZ_INCLUDED := util/kmsg.c
testing/fuzz/fuzz-serializer: FUZZ_INCLUDED := util/upatch_maps.c
testing/fuzz/fuzz-decoder: FUZZ_INCLUDED := util/upatch_decode.c

$(FUZZ_TARGETS): testing/fuzz/fuzz.h
	@printf '  FUZZ    $@\n'
	$(Q)$(FUZZ_CC) $(FUZZ_CFLAGS) -o $@ \
		$(filter-out $(FUZZ_INCLUDED),$(filter %.c,$^)) $(FUZZ_LIBS)

fuzz-targets: $(FUZZ_TARGETS)

check test: shirudo $(TEST_HELPERS)
	@printf '  TEST\n'
	$(Q)cd testing && ./run-tests.sh

# ----- clean ------------------------------------------------------

clean:
	$(Q)rm -f shirudo shirudo-target tools/shirudo-build/shirudo-build $(TEST_HELPERS)
	$(Q)rm -f $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) \
	          $(BUILD_OBJS) $(VERSION_OBJ) util/version_id.c
	$(Q)rm -rf build/target
	$(Q)rm -f $(DEPS) testing/helper/*.d
	$(Q)rm -f $(BPF_OBJS) $(VMLINUX_H) systemd/shirudo.service \
	    systemd/shirudo-initrd.service \
	          systemd/shirudo-map-export.service \
	          systemd/shirudo-keepalive.service \
	          systemd/shirudo-bpm-repo-update.service \
	          systemd/shirudo-bpm-tree-sync.service

distclean:
	$(Q)$(MAKE) -C $(LIBBPF_VENDOR) clean
	$(Q)rm -f $(VMLINUX_GEN)
