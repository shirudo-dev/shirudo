test-helpers: $(TEST_HELPERS)

# ----- unit tests -------------------------------------------------

# util/<m>.c is tested by testing/unit/<m>.c. Each test links the util
# objects from an archive, so it pulls in only what its module needs.
UNIT_SRCS  := $(filter-out testing/unit/unit.c,$(wildcard testing/unit/*.c))
UNIT_TESTS := $(patsubst testing/unit/%.c,build/unit/%,$(UNIT_SRCS))
UNIT_LIB   := build/unit/libshirudo.a

$(UNIT_LIB): $(UTIL_OBJS) $(VERSION_OBJ)
	@printf '  AR      $@\n'
	$(Q)mkdir -p $(dir $@)
	$(Q)rm -f $@
	$(Q)$(AR) rcs $@ $^

# The quote checker's rows are no util module: its suite links the
# object the program is built from.
build/unit/quote_check: UNIT_OBJS := tools/quote-check/row.o
build/unit/quote_check: tools/quote-check/row.o

# The same for the builder's jar check.
build/unit/jar: UNIT_OBJS := tools/shirudo-build/jar.o
build/unit/jar: tools/shirudo-build/jar.o

UNIT_COVERAGE_CFLAGS = $(if $(filter --coverage,$(CFLAGS)),-DUNIT_GCOV)

build/unit/%: testing/unit/%.c testing/unit/unit.c testing/unit/unit.h \
		$(UNIT_LIB) $(LIBBPF_A)
	@printf '  CC      $@\n'
	$(Q)$(CC) $(CFLAGS) $(UNIT_COVERAGE_CFLAGS) $(LDFLAGS) -Itesting/unit \
		-o $@ $< testing/unit/unit.c \
		$(UNIT_OBJS) $(UNIT_LIB) $(LIBBPF_A) $(DYNAMIC_LIBS)

build/unit/curl: LDFLAGS += -Wl,--wrap=curl_slist_free_all
build/unit/upatch_pins: LDFLAGS += -Wl,--wrap=opendir,--wrap=readdir64

unit-tests: $(UNIT_TESTS)

# ----- sparse -----------------------------------------------------

# make sparse runs sparse over the sources the binaries are built from,
# the vendored ones aside, and fails on any warning it gives. The
# vendored linux/types.h defines __bitwise as nothing, so sparse reads
# the system's copy, which makes __le32 and its kin restricted types
# under __CHECKER__, in its place. _FORTIFY_SOURCE=3 and libcurl's
# typecheck-gcc.h are left out: sparse does not know the builtin the
# first needs and reports the sizeof the second applies to a function,
# and the compiler runs both checks. sparse has no __has_include either,
# which glibc 2.43 asks to find <linux/openat2.h> before declaring a
# struct open_how of its own; __glibc_has_open_how gives the answer the
# compiler would. sparse predefines no __FLT_EVAL_METHOD__, which
# glibc's <math.h> tests, so -Wundef is the compiler's to check.
SPARSE_TYPES_H ?= /usr/include/linux/types.h
SPARSE_SRCS    := shirudo.c $(BUILTIN_SRCS) $(UTIL_SRCS) $(BUILD_SRCS) \
                  $(QUOTE_CHECK_SRCS)

.PHONY: sparse
sparse:
	$(Q)for f in $(SPARSE_SRCS); do \
		printf '  SPARSE  %s\n' "$$f"; \
		cgcc -no-compile -Wsparse-error $(CFLAGS) -Wno-undef \
		     -U_FORTIFY_SOURCE \
		     -DCURL_DISABLE_TYPECHECK -D__glibc_has_open_how=1 \
		     -include $(SPARSE_TYPES_H) -D_UAPI_LINUX_TYPES_H \
		     "$$f" || exit 1; \
	done

# ----- fuzzing ----------------------------------------------------

# libFuzzer targets for the parsers of input from outside the host, built
# with clang from the util sources under the sanitizers SANITIZE names, ASan
# and UBSan without it; make -C testing fuzz builds and runs them. FUZZ_OUT
# keeps the builds of another engine apart, as make -C testing afl does.
FUZZ_CC ?= clang
FUZZ_OUT ?= testing/fuzz
FUZZ_SANITIZE := $(if $(SANITIZE),$(SANITIZE_CFLAGS), \
                 -fsanitize=address$(comma)undefined)
FUZZ_WARNINGS := $(call cc-option,$(FUZZ_CC),$(PROBED_WARNINGS))
FUZZ_CFLAGS := -O1 -g -std=gnu11 -fno-omit-frame-pointer $(LANG_CFLAGS) \
               $(call cc-option,$(FUZZ_CC),$(PROBED_LANG)) \
               -fsanitize=fuzzer $(FUZZ_SANITIZE) \
               -fno-sanitize-recover=all $(WARNINGS) $(FUZZ_WARNINGS) \
               -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE $(INCLUDES) \
               $(LIBCRYPTO_CFLAGS) $(LIBCURL_CFLAGS) $(ZLIB_CFLAGS)
FUZZ_LIBS := $(LIBCRYPTO_LIBS) $(LIBSSL_LIBS) $(LIBCURL_LIBS) $(ZLIB_LIBS)
FUZZ_BASE := util/json.c util/string.c util/hex.c util/malloc.c \
             testing/fuzz/log.c
FUZZ_CONFIG := util/config.c util/image_config.c
FUZZ_SEAL := util/seal.c $(FUZZ_CONFIG)
FUZZ_OCI := util/bpm_oci.c util/curl.c util/io.c $(FUZZ_SEAL) \
            util/crypto_openssl.c util/tls_openssl.c
FUZZ_PACKAGE := util/bpm_package.c util/bpm_tree.c util/chain_history.c \
                util/upatch.c util/keys.c $(FUZZ_OCI)

FUZZ_TARGETS := $(patsubst testing/fuzz/%.c,$(FUZZ_OUT)/%, \
                $(wildcard testing/fuzz/fuzz-*.c))

$(FUZZ_OUT)/fuzz-tpm-command: testing/fuzz/fuzz-tpm-command.c $(FUZZ_BASE) \
                               include/shirudo/tpm_command.h

$(FUZZ_OUT)/fuzz-json: testing/fuzz/fuzz-json.c $(FUZZ_BASE)
$(FUZZ_OUT)/fuzz-oci-manifest: testing/fuzz/fuzz-oci-manifest.c \
                                $(FUZZ_BASE) $(FUZZ_OCI)
$(FUZZ_OUT)/fuzz-bpm-index: testing/fuzz/fuzz-bpm-index.c \
                             $(FUZZ_BASE) $(FUZZ_PACKAGE)
$(FUZZ_OUT)/fuzz-tree: testing/fuzz/fuzz-tree.c $(FUZZ_BASE) \
                        util/bpm_tree.c util/chain_history.c \
                        util/upatch.c $(FUZZ_OCI)
$(FUZZ_OUT)/fuzz-upatch: testing/fuzz/fuzz-upatch.c $(FUZZ_BASE) \
                          util/upatch.c
$(FUZZ_OUT)/fuzz-prog-metadata: testing/fuzz/fuzz-prog-metadata.c \
                                 $(FUZZ_BASE) util/upatch.c
$(FUZZ_OUT)/fuzz-rodata: testing/fuzz/fuzz-rodata.c $(FUZZ_BASE) \
                          util/upatch.c util/upatch_rodata.c util/format.c \
                          util/io.c $(FUZZ_SEAL) $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-rodata: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-rodata: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS) $(ZLIB_LIBS)
$(FUZZ_OUT)/fuzz-bpm-tar: testing/fuzz/fuzz-bpm-tar.c $(FUZZ_BASE) \
                           $(FUZZ_PACKAGE)
$(FUZZ_OUT)/fuzz-bpm-package: testing/fuzz/fuzz-bpm-package.c $(FUZZ_BASE) \
                               $(FUZZ_PACKAGE)
$(FUZZ_OUT)/fuzz-tpm-wire: testing/fuzz/fuzz-tpm-wire.c $(FUZZ_BASE) \
                            util/tpm_wire.c util/crypto_openssl.c util/io.c \
                            $(FUZZ_SEAL)
$(FUZZ_OUT)/fuzz-attest: testing/fuzz/fuzz-attest.c $(FUZZ_BASE) \
                          util/attest.c util/chain.c util/chain_history.c \
                          util/nv_writer.c util/tpm.c \
                          util/tpm_wire.c util/eventlog.c util/timefmt.c \
                          util/crypto_openssl.c util/io.c $(FUZZ_SEAL) \
                          util/config_attest.c util/config_update.c \
                          util/config_measure.c util/initrd.c util/identity.c \
                          util/keyring.c util/version_id.c util/upatch.c \
                          $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-attest: FUZZ_CFLAGS += $(TSS2_CFLAGS) $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-attest: FUZZ_LIBS += $(TSS2_LIBS) $(LIBBPF_A) $(LIBELF_LIBS) $(ZLIB_LIBS)
$(FUZZ_OUT)/fuzz-eventlog: testing/fuzz/fuzz-eventlog.c $(FUZZ_BASE) \
                            util/eventlog.c util/timefmt.c util/upatch.c \
                            $(FUZZ_SEAL) util/io.c util/crypto_openssl.c \
                            util/identity.c testing/fuzz/chain.c $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-eventlog: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-eventlog: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS) $(ZLIB_LIBS)
$(FUZZ_OUT)/fuzz-kernel: testing/fuzz/fuzz-kernel.c $(FUZZ_BASE) \
                          util/kernel_build_id.c
$(FUZZ_OUT)/fuzz-elf: testing/fuzz/fuzz-elf.c $(FUZZ_BASE) \
                       util/elf_target.c $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-elf: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-elf: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS)
$(FUZZ_OUT)/fuzz-serializer: testing/fuzz/fuzz-serializer.c $(FUZZ_BASE) \
                              util/upatch_maps.c util/upatch_pins.c \
                              util/upatch_resolve.c util/serializer.c $(FUZZ_SEAL) util/io.c util/paths.c \
                              util/timefmt.c $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-serializer: FUZZ_CFLAGS += $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-serializer: FUZZ_LIBS += $(LIBBPF_A) $(LIBELF_LIBS)
$(FUZZ_OUT)/fuzz-cms: testing/fuzz/fuzz-cms.c $(FUZZ_BASE) util/keys.c \
                       util/crypto_openssl.c util/io.c $(FUZZ_SEAL)
$(FUZZ_OUT)/fuzz-decoder: testing/fuzz/fuzz-decoder.c $(FUZZ_BASE) \
                           util/upatch_decode.c util/upatch.c util/io.c \
                           util/crypto_openssl.c $(FUZZ_SEAL)
$(FUZZ_OUT)/fuzz-decoder: FUZZ_CFLAGS += $(LUAJIT_CFLAGS) -DHAVE_LUAJIT \
	-DFUZZ_SOURCE_TREE='"$(CURDIR)"'
$(FUZZ_OUT)/fuzz-decoder: FUZZ_LIBS += $(LUAJIT_LIBS)
$(FUZZ_OUT)/fuzz-otel: testing/fuzz/fuzz-otel.c $(FUZZ_BASE) \
                        util/upatch_maps_otel.c util/curl.c \
                        util/crypto_openssl.c \
                        util/tls_openssl.c util/io.c util/version_id.c \
                        $(FUZZ_SEAL)
$(FUZZ_OUT)/fuzz-beefile: testing/fuzz/fuzz-beefile.c $(FUZZ_BASE) \
                           tools/shirudo-build/bpm-build.c $(FUZZ_PACKAGE) \
                           util/upatch.c util/timefmt.c util/paths.c \
                           util/version_id.c util/options.c util/help.c \
                           util/similar.c
$(FUZZ_OUT)/fuzz-oci-http: testing/fuzz/fuzz-oci-http.c $(FUZZ_BASE) \
                            $(FUZZ_OCI)
$(FUZZ_OUT)/fuzz-oci-ref: testing/fuzz/fuzz-oci-ref.c $(FUZZ_BASE) \
                           $(FUZZ_OCI)
$(FUZZ_OUT)/fuzz-registry-auth: testing/fuzz/fuzz-registry-auth.c \
                                 $(FUZZ_BASE) $(FUZZ_OCI)
$(FUZZ_OUT)/fuzz-config: testing/fuzz/fuzz-config.c $(FUZZ_BASE) \
                          $(FUZZ_CONFIG) util/seal.c util/io.c \
                          util/bpm_source_config.c
$(FUZZ_OUT)/fuzz-image: testing/fuzz/fuzz-image.c $(FUZZ_BASE) \
                         util/image_bootstrap.c util/config_image.c \
                         util/config_measure.c util/crypto_openssl.c \
                         util/io.c util/paths.c \
                         $(FUZZ_SEAL)
$(FUZZ_OUT)/fuzz-config-update: testing/fuzz/fuzz-config-update.c \
                                 $(FUZZ_BASE) util/config_update.c \
                                 util/config_measure.c testing/fuzz/chain.c \
                                 util/crypto_openssl.c util/io.c $(FUZZ_SEAL)
FUZZ_TREE_STATE := util/bpm_tree_state.c util/bpm_tree.c \
                   util/chain_history.c util/upatch.c $(FUZZ_OCI) \
                   util/kconfig.c util/kernel_build_id.c \
                   util/kernel_release.c \
                   testing/fuzz/chain.c
$(FUZZ_OUT)/fuzz-tree-state: testing/fuzz/fuzz-tree-state.c $(FUZZ_BASE) \
                              $(FUZZ_TREE_STATE)
$(FUZZ_OUT)/fuzz-kconfig: testing/fuzz/fuzz-kconfig.c $(FUZZ_BASE) \
                           $(FUZZ_TREE_STATE)
$(FUZZ_OUT)/fuzz-quote-check: testing/fuzz/fuzz-quote-check.c $(FUZZ_BASE) \
                               tools/quote-check/row.c util/tpm_wire.c \
                               util/crypto_openssl.c util/io.c util/seal.c
$(FUZZ_OUT)/fuzz-upatch-info: testing/fuzz/fuzz-upatch-info.c $(FUZZ_BASE) \
                              testing/fuzz/output.c builtin-upatch.c \
                              builtin.h util/chain.c util/crypto_openssl.c \
                              util/curl.c util/elf_target.c util/eventlog.c \
                              util/help.c util/identity.c util/initrd.c \
                              util/io.c util/java_agent.c util/kernel_abi.c \
                              util/keyring.c util/keys.c util/measured.c \
                              util/nv_writer.c \
                              util/options.c util/paths.c util/report.c \
                              util/serializer.c util/similar.c \
                              util/timefmt.c util/tls_openssl.c util/tpm.c \
                              util/tpm_wire.c util/upatch.c \
                              util/upatch_decode.c util/upatch_maps.c \
                              util/upatch_maps_otel.c util/upatch_pins.c \
                              util/upatch_resolve.c util/upatch_table.c \
                              util/upatch_verify.c util/version_id.c \
                              util/xdp.c $(FUZZ_SEAL) $(LIBBPF_A)
# util/upatch_decode.c defines upatch_decode_map_signal(), which
# builtin-upatch.c calls, with LuaJIT alone; upatch info runs no Lua.
$(FUZZ_OUT)/fuzz-upatch-info: FUZZ_CFLAGS += $(TSS2_CFLAGS) $(LIBELF_CFLAGS) \
                                             $(LUAJIT_CFLAGS) -DHAVE_LUAJIT
$(FUZZ_OUT)/fuzz-upatch-info: FUZZ_LIBS += $(TSS2_LIBS) $(LIBBPF_A) \
                                           $(LIBELF_LIBS) $(LUAJIT_LIBS)
$(FUZZ_OUT)/fuzz-bpm-info: testing/fuzz/fuzz-bpm-info.c $(FUZZ_BASE) \
                           testing/fuzz/output.c builtin-bpm.c builtin.h \
                           $(FUZZ_PACKAGE) util/bpm_source_config.c \
                           util/bpm_state.c util/bpm_tree_state.c \
                           util/chain.c util/eventlog.c util/help.c \
                           util/identity.c util/image_keys.c \
                           util/initrd.c util/kconfig.c \
                           util/kernel_build_id.c \
                           util/kernel_release.c util/keyring.c \
                           util/nv_writer.c util/options.c util/paths.c \
                           util/similar.c util/timefmt.c util/tpm.c \
                           util/tpm_wire.c util/upatch_pins.c \
                           util/upatch_rodata.c util/format.c $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-bpm-info: FUZZ_CFLAGS += $(TSS2_CFLAGS) $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-bpm-info: FUZZ_LIBS += $(TSS2_LIBS) $(LIBBPF_A) $(LIBELF_LIBS)
$(FUZZ_OUT)/fuzz-attest-report: testing/fuzz/fuzz-attest-report.c \
                               $(FUZZ_BASE) testing/fuzz/output.c \
                               builtin-attest.c builtin.h util/attest.c \
                               util/chain.c util/chain_history.c \
                               util/config_attest.c util/config_measure.c \
                               util/config_update.c util/crypto_openssl.c \
                               util/eventlog.c util/help.c util/identity.c \
                               util/initrd.c util/io.c util/keyring.c \
                               util/keys.c util/measured.c util/nv_writer.c \
                               util/options.c util/paths.c util/similar.c \
                               util/timefmt.c util/tpm.c util/tpm_wire.c \
                               util/upatch.c util/version_id.c $(FUZZ_SEAL) \
                               $(LIBBPF_A)
$(FUZZ_OUT)/fuzz-attest-report: FUZZ_CFLAGS += $(TSS2_CFLAGS) $(LIBELF_CFLAGS)
$(FUZZ_OUT)/fuzz-attest-report: FUZZ_LIBS += $(TSS2_LIBS) $(LIBBPF_A) \
                                             $(LIBELF_LIBS)

# A target that reaches static parsers or printers includes their source,
# which it then depends on without linking it a second time.
$(FUZZ_OUT)/fuzz-oci-http: FUZZ_INCLUDED := util/bpm_oci.c
$(FUZZ_OUT)/fuzz-tree-state $(FUZZ_OUT)/fuzz-kconfig: \
	FUZZ_INCLUDED := util/bpm_tree_state.c
$(FUZZ_OUT)/fuzz-otel: FUZZ_INCLUDED := util/upatch_maps_otel.c
$(FUZZ_OUT)/fuzz-serializer: FUZZ_INCLUDED := util/upatch_maps.c
$(FUZZ_OUT)/fuzz-decoder: FUZZ_INCLUDED := util/upatch_decode.c
$(FUZZ_OUT)/fuzz-config-update: FUZZ_INCLUDED := util/config_update.c
$(FUZZ_OUT)/fuzz-upatch-info: FUZZ_INCLUDED := builtin-upatch.c
$(FUZZ_OUT)/fuzz-bpm-info: FUZZ_INCLUDED := builtin-bpm.c
$(FUZZ_OUT)/fuzz-attest-report: FUZZ_INCLUDED := builtin-attest.c

# A target compiles its sources and links in one step, so it depends on
# every header a source may include, and on the compiler and flags it was
# built with: a binary built against an older header or by another
# compiler looks current otherwise.
FUZZ_HEADERS := testing/fuzz/fuzz.h $(wildcard include/shirudo/*.h util/*.h \
                tools/shirudo-build/*.h tools/quote-check/*.h)
FUZZ_STAMP := $(FUZZ_OUT)/.fuzz-flags
FUZZ_SIGNATURE := $(FUZZ_CC) $(FUZZ_CFLAGS) $(LDFLAGS) $(FUZZ_LIBS) \
                  $(AFL_LLVM_CMPLOG)

.PHONY: FORCE_FUZZ_FLAGS
FORCE_FUZZ_FLAGS:

$(FUZZ_STAMP): FORCE_FUZZ_FLAGS
	$(Q)mkdir -p $(dir $@)
	$(Q)printf '%s\n' '$(subst ','\'',$(FUZZ_SIGNATURE))' | \
	    cmp -s - $@ 2>/dev/null || \
	    printf '%s\n' '$(subst ','\'',$(FUZZ_SIGNATURE))' > $@

$(FUZZ_TARGETS): $(FUZZ_HEADERS) $(FUZZ_STAMP)
	@printf '  FUZZ    $@\n'
	$(Q)$(FUZZ_CC) $(FUZZ_CFLAGS) $(LDFLAGS) -o $@ \
		$(filter-out $(FUZZ_INCLUDED),$(filter %.c,$^)) $(FUZZ_LIBS)

fuzz-targets: $(FUZZ_TARGETS)

# ----- clean ------------------------------------------------------

clean:
	$(Q)rm -f shirudo shirudo-target tools/shirudo-build/shirudo-build $(TEST_HELPERS)
	$(Q)rm -f tools/quote-check/shirudo-quote-check
	$(Q)rm -f $(MAIN_OBJ) $(BUILTIN_OBJS) $(UTIL_OBJS) \
	          $(BUILD_OBJS) $(SIGN_OBJ) $(QUOTE_CHECK_OBJS) $(VERSION_OBJ) \
	          util/version_id.c
	$(Q)rm -rf build/target build/unit build/quote-check build/fuzz-afl \
	    build/fuzz-afl-cmplog
	$(Q)rm -f $(DEPS) testing/helper/*.d
	$(Q)rm -f $(BPF_OBJS) $(VMLINUX_H) systemd/shirudo.service \
	    systemd/shirudo-initrd.service \
	          systemd/shirudo-map-export.service \
	          systemd/shirudo-keepalive.service \
	          systemd/shirudo-bpm-repo-update.service \
	          systemd/shirudo-bpm-tree-sync.service

distclean:
	$(Q)$(MAKE) -C $(LIBBPF_VENDOR) clean
	$(Q)rm -f $(VMLINUX_GEN)
