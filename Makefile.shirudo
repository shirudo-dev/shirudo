                        util/config.o util/image_config.o \
                        util/upatch_decode.o util/upatch_pins.o \
                        util/upatch_resolve.o \
                        util/upatch.o util/json.o util/string.o util/log.o \
                        util/paths.o \
                        util/io.o util/malloc.o $(LIBBPF_A) util/hex.o util/timefmt.o
	@printf '  CC      $@\n'
