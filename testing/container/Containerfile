# The build environment of the test VM bundle: Ubuntu 26.04, the release
# the test VMs run, with its OpenSSL 3.5 and clang 23 from install-clang.sh,
# so that the bundle builds alike on every host and what it carries into a
# guest links against the libraries the guest has. The static archives that
# libcrypto.a names come from install-static-libcrypto-deps.sh, as in CI, for
# the static shirudo-quote-check.

FROM docker.io/library/ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

COPY packages install-clang.sh install-static-libcrypto-deps.sh /tmp/shirudo-build/
RUN export DEBIAN_FRONTEND=noninteractive && \
	apt-get update && \
	apt-get install -y --no-install-recommends \
		$(cat /tmp/shirudo-build/packages) && \
	sh /tmp/shirudo-build/install-static-libcrypto-deps.sh && \
	sh /tmp/shirudo-build/install-clang.sh && \
	rm -rf /var/lib/apt/lists/* /tmp/shirudo-build
