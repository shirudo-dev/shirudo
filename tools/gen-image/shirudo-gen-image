set -euo pipefail

usage()
{
	cat <<'EOF'
usage: shirudo-gen-image --source <directory> --output <prefix>
       --keys-dir <operator-key-directory> [--kind config|runtime] [--size <MiB>]
       [--builder <shirudo-build>]

Build an ext4 image and detached signed dm-verity metadata on the operator.
Writes <prefix>.img, <prefix>.verity, <prefix>.roothash and <prefix>.p7s.
The source directory is the filesystem root; it is not the host rootfs.
No existing output file is replaced. The private key never enters the image.
EOF
}

die()
{
	printf 'shirudo-gen-image: %s\n' "$*" >&2
	exit 1
}

source_dir=
output=
keys_dir=
kind=config
size=64
builder=${SHIRUDO_BUILD:-shirudo-build}

while [ $# -gt 0 ]; do
	case "$1" in
	--source) source_dir=${2:?}; shift 2 ;;
	--output) output=${2:?}; shift 2 ;;
	--keys-dir) keys_dir=${2:?}; shift 2 ;;
	--kind) kind=${2:?}; shift 2 ;;
	--size) size=${2:?}; shift 2 ;;
	--builder) builder=${2:?}; shift 2 ;;
	-h|--help) usage; exit 0 ;;
	*) usage >&2; die "unknown option: $1" ;;
	esac
done

[ -n "$source_dir" ] && [ -d "$source_dir" ] || die '--source needs a directory'
[ -n "$output" ] || die '--output is required'
[ -n "$keys_dir" ] && [ -d "$keys_dir" ] || die '--keys-dir needs a directory'
case "$kind" in config|runtime) ;; *) die '--kind must be config or runtime' ;; esac
case "$size" in ''|*[!0-9]*) die '--size must be an integer in MiB' ;; esac
[ "${#size}" -le 7 ] && [ "$size" -ge 8 ] && [ "$size" -le 1048576 ] ||
	die '--size must be between 8 and 1048576 MiB'
command -v veritysetup >/dev/null || die 'install veritysetup (cryptsetup-bin or cryptsetup)'
command -v mkfs.ext4 >/dev/null || die 'install e2fsprogs (mkfs.ext4)'
command -v "$builder" >/dev/null || die 'shirudo-build not found; use --builder'

source_dir=$(realpath "$source_dir")
keys_dir=$(realpath "$keys_dir")
case "$keys_dir/" in "$source_dir/"*) die 'operator keys must be outside the image source' ;; esac
for suffix in .img .verity .roothash .p7s; do
	[ ! -e "$output$suffix" ] && [ ! -L "$output$suffix" ] ||
		die "output already exists: $output$suffix"
done
if find "$source_dir" -type f -name signing_key.pem -print -quit | grep -q .; then
	die 'the image source contains a private signing key'
fi
if [ "$kind" = config ] && find "$source_dir" -type l -print -quit | grep -q .; then
	die 'config images must not contain symbolic links'
fi
if find "$source_dir" ! -type d ! -type f ! -type l -print -quit | grep -q .; then
	die 'the image source contains a special file'
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
truncate -s "${size}M" "$work/filesystem.img"
mkfs.ext4 -q -F -b 4096 -O '^has_journal' -E root_owner=0:0 \
	-d "$source_dir" "$work/filesystem.img"
"$builder" image build "$work/filesystem.img" -o "$output" \
	--kind "$kind" --keys-dir "$keys_dir"
"$builder" image verify "$output" --cert "$keys_dir/cert.der" >/dev/null
