set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/common.sh"

usage()
{
	cat <<'EOF'
usage: shirudo-gen-runtime --binary <shirudo-runtime> --bootstrap-binary <shirudo-target>
       --bootstrap-conf <file>
       --cert <initial-BPF-cert.der> --config-cert <config-cert.der>
       --output <prefix> --keys-dir <operator-key-directory>
       [--size <MiB>] [--builder <shirudo-build>] [--unit-output <file>]
       [--closure-output <file>]
       [--extra-binary <trusted-ELF>] [--config-cert <additional-cert.der>]

Package the trusted executable, its complete dynamic-library closure,
authenticated bootstrap settings and public certificates into a runtime image.
Build the final ELF with make runtime. The separate bootstrap input must be
trusted: ldd invokes its dynamic loader on the operator. Final bytes are validated
and copied unchanged; dynamic extra binaries need the same runtime link flags.
Repeat --config-cert to allow overlapping keys.
EOF
}

parse_args()
{
	while [ $# -gt 0 ]; do
		case "$1" in
		--binary) binary=${2:?}; shift 2 ;;
		--bootstrap-binary) bootstrap_binary=${2:?}; shift 2 ;;
		--closure-output) closure_output=${2:?}; shift 2 ;;
		--bootstrap-conf) conf=${2:?}; shift 2 ;;
		--cert) cert=${2:?}; shift 2 ;;
		--config-cert) config_certs+=("${2:?}"); shift 2 ;;
		--output) output=${2:?}; shift 2 ;;
		--keys-dir) keys_dir=${2:?}; shift 2 ;;
		--size) size=${2:?}; shift 2 ;;
		--builder) builder=${2:?}; shift 2 ;;
		--unit-output) unit_output=${2:?}; shift 2 ;;
		--extra-binary) extra_binaries+=("${2:?}"); shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; die "unknown option: $1" ;;
		esac
	done
}

check_inputs()
{
	local file i j

	for file in "$binary" "$bootstrap_binary" "$conf" "$cert"; do
		[ -n "$file" ] && [ -f "$file" ] ||
			die 'runtime/bootstrap binaries, bootstrap config and BPF public certificate are required'
	done
	[ "${#config_certs[@]}" -gt 0 ] || die 'a config public certificate is required'
	[ "${#config_certs[@]}" -le 16 ] || die 'at most 16 config certificates are allowed'
	for ((i = 0; i < ${#config_certs[@]}; i++)); do
		file=${config_certs[i]}
		[ -f "$file" ] || die "config certificate not found: $file"
		for ((j = 0; j < i; j++)); do
			! cmp -s "$file" "${config_certs[j]}" || die 'duplicate config certificate'
		done
	done
	check_image_options "$output" "$keys_dir" "$size"
	require_command python3 'install Python 3 for runtime ELF validation'
	"$here/shirudo-runtime-elf" validate --binary "$binary" --bootstrap-binary "$bootstrap_binary"
	if [ -n "$closure_output" ]; then
		require_new_output "$closure_output" 'closure output'
	fi
}

stage_config_certificates()
{
	local runtime_conf="$work/root/etc/shirudo/shirudo.conf"
	local name i

	awk '!/^[[:space:]]*config[.]verification_key[[:space:]]*=/' \
		"$conf" >"$runtime_conf"
	chmod 0644 "$runtime_conf"
	for ((i = 0; i < ${#config_certs[@]}; i++)); do
		name=config-cert.der
		if [ "$i" -gt 0 ]; then
			name="config-cert-$((i + 1)).der"
		fi
		install -m 0644 "${config_certs[i]}" "$work/root/etc/shirudo/$name"
		printf 'config.verification_key=/run/shirudo/runtime/etc/shirudo/%s\n' \
			"$name" >>"$runtime_conf"
	done
}

stage_files()
{
	local extra
	local -a stage_args=(stage --binary "$binary" --bootstrap-binary "$bootstrap_binary" --root "$work/root")

	mkdir -p "$work/root/usr/bin" "$work/root/etc/shirudo" "$work/root/keys"
	install -m 0644 "$cert" "$work/root/keys/cert.der"
	stage_config_certificates
	for extra in "${extra_binaries[@]}"; do
		stage_args+=(--extra-binary "$extra")
	done
	"$here/shirudo-runtime-elf" "${stage_args[@]}" >"$work/closure.json"
}

build_runtime_image()
{
	"$here/shirudo-gen-image" --source "$work/root" --output "$output" \
		--keys-dir "$keys_dir" --kind runtime --size "$size" --builder "$builder"
	printf 'Runtime invocation (after the authenticated image is mounted):\n' >&2
	printf '%s init\n' /run/shirudo/runtime/usr/bin/shirudo >&2
	if [ -n "$closure_output" ]; then
		(set -o noclobber; cat "$work/closure.json" >"$closure_output")
	fi
}

write_service()
{
	[ -n "$unit_output" ] || return 0
	require_new_output "$unit_output" 'unit output'
	(set -o noclobber; cat "$here/runtime-service.conf.in" >"$unit_output")
}

main()
{
	parse_args "$@"
	check_inputs
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	stage_files
	build_runtime_image
	write_service
}

binary=
bootstrap_binary=
closure_output=
conf=
cert=
config_certs=()
output=
keys_dir=
size=128
builder=${SHIRUDO_BUILD:-shirudo-build}
unit_output=
extra_binaries=()
main "$@"
