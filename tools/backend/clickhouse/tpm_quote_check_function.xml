<?xml version="1.0"?>
<!--
  SPDX-License-Identifier: BSD-2-Clause
  Copyright (c) 2026 Authors of shirudo

  Declares tpm_quote_check(attest, sig, ak, body_sha256) over the
  shirudo-quote-check program of the shirudo operator package. Install
  this file beside the server's config.xml and the program in the
  server's user_scripts directory.
-->
<clickhouse>
    <function>
        <type>executable_pool</type>
        <name>tpm_quote_check</name>
        <command>shirudo-quote-check</command>
        <format>TabSeparated</format>
        <argument>
            <type>String</type>
            <name>attest</name>
        </argument>
        <argument>
            <type>String</type>
            <name>sig</name>
        </argument>
        <argument>
            <type>String</type>
            <name>ak</name>
        </argument>
        <argument>
            <type>String</type>
            <name>body_sha256</name>
        </argument>
        <return_type>String</return_type>
        <pool_size>4</pool_size>
        <deterministic>true</deterministic>
    </function>
</clickhouse>
