status	Enum8(\'healthy\' = 1, \'unhealthy\' = 2, \'stale\' = 3)
trust	Enum8(\'untrusted\' = 0, \'enrolled\' = 1)
image_id	String
image_version	String
binding	Enum8(\'verified\' = 1, \'declared\' = 2, \'root_mismatch\' = 3, \'no_sbom\' = 4, \'no_image\' = 5)
sbom_stale	Bool
source	Enum8(\'sbom\' = 1, \'kernel\' = 2, \'none\' = 3)
vuln_id	String
severity	LowCardinality(String)
package	String
installed	String
fixed	String
exposure	Enum8(\'shielded\' = 1, \'shield_pending\' = 2, \'shield_module_absent\' = 3, \'shield_excludes_node\' = 4, \'shield_withdrawn\' = 5, \'exposed_no_shield\' = 6, \'none\' = 7, \'unknown\' = 8)
upatch_id	String
applied_seq	UInt64
applied_op	Enum8(\'\' = 0, \'add\' = 1, \'delete\' = 2)
next_seq	UInt64
next_op	Enum8(\'\' = 0, \'add\' = 1, \'delete\' = 2)
next_shields	Bool
shield_link	Enum8(\'none\' = 0, \'fixes\' = 1, \'manual\' = 2)
