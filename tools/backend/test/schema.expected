boot_first	AggregatingMergeTree ORDER BY (ak_name, boot_id) TTL last_used + toIntervalSecond(2592000) SETTINGS index_granularity = 8192
keepalive	ReplacingMergeTree ORDER BY (ak_name, reset_count, clock) TTL toDateTime(received) + toIntervalSecond(3600) SETTINGS index_granularity = 8192
keepalive_latest	ReplacingMergeTree(order_key) ORDER BY ak_name SETTINGS index_granularity = 8192
node_ops	ReplacingMergeTree ORDER BY (ak_name, tree_id, seq) SETTINGS deduplicate_merge_projection_mode = \'rebuild\', index_granularity = 8192
node_sets	ReplacingMergeTree(last_seq) ORDER BY (ak_name, tree_id, id) SETTINGS index_granularity = 8192
rejected	MergeTree ORDER BY received TTL toDateTime(received) + toIntervalDay(7) SETTINGS index_granularity = 8192
sbom_images	ReplacingMergeTree(scanned_at) ORDER BY (image_id, image_version, image_root) SETTINGS index_granularity = 8192
sbom_vulns	MergeTree ORDER BY (sbom_sha256, vuln_id, package) TTL scanned_at + toIntervalDay(7) SETTINGS index_granularity = 8192
ak_name	String
ak_public	SimpleAggregateFunction(max, String)
node_id	AggregateFunction(argMin, String, DateTime64(3))
first_seen	SimpleAggregateFunction(min, Nullable(DateTime64(3)))
trust	SimpleAggregateFunction(max, Enum8(\'untrusted\' = 0, \'enrolled\' = 1))
node_id	String
ak_name	String
host_name	String
status	Enum8(\'healthy\' = 1, \'unhealthy\' = 2, \'stale\' = 3)
trust	Enum8(\'untrusted\' = 0, \'enrolled\' = 1)
