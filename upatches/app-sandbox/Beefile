[package]
name = "app-sandbox"
description = "Sandbox php2shell vulnerable applications: Block lateral movement into other binaries and unexpected sockets."
license = "GPL-2.0 OR BSD-2-Clause"
authors = ["Authors of shirudo"]

[[files]]
source = "sandbox.toml"

[[files]]
source = "gen_policy.py"

[[upatches]]
source = "app-sandbox.bpf.c"

[[upatches.rodata]]
symbol = "sandbox_policy"
input = "sandbox.toml"
generator = ["python3", "gen_policy.py"]
update = ["python3", "gen_policy.py"]

# One table per sandbox: sandbox.toml gives the rules of the tasks that
# execute one of its paths.
[[upatches.policy]]
id = "apache"
bit = 0x1
paths = ["/usr/sbin/apache2", "/usr/sbin/httpd", "/usr/local/apache2/bin/httpd"]

[[upatches.policy]]
id = "php-fpm"
bit = 0x2
paths = ["/usr/sbin/php-fpm*", "/usr/local/sbin/php-fpm"]

[[upatches.policy]]
id = "nginx"
bit = 0x4
paths = ["/usr/sbin/nginx", "/usr/local/nginx/sbin/nginx", "/usr/local/openresty/nginx/sbin/nginx"]

[upatches.tree]
id = "app-sandbox"
fixes = ["CVE-2026-109618", "CVE-2026-109619", "CVE-2026-115560", "CVE-2026-123007", "CVE-2026-123633"]
