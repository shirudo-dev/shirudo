#
# shirudo reboot-persistence unit: the root file system's half.
#
# bpffs and the kernel keyrings do not survive a reboot, so the BPF LSM
# and the loaded upatch set must be re-applied on every boot. This unit
# runs `shirudo init` as early as a filesystem-dependent service can,
# inside the sysinit phase.
#
# The initrd loads the authenticated runtime and signed config before
# switch-root. This unit starts the runtime image's binary directly for
# static target packages; dynamic binaries use the drop-in generated by
# shirudo-gen-runtime. This run adopts the initrd eventlog record and
# checks the existing state.

[Unit]
Description=shirudo: bring up the BPF LSM and re-apply signed upatches
DefaultDependencies=no
After=local-fs.target systemd-tpm2-setup-early.service
After=systemd-pcrnvdone.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/lib/shirudo
ConditionPathIsMountPoint=/run/shirudo/runtime

[Service]
Type=oneshot
SyslogIdentifier=shirudo
LimitMEMLOCK=infinity
RemainAfterExit=yes
KeyringMode=inherit
EnvironmentFile=-/etc/shirudo/init.env
ExecStart=/run/shirudo/runtime/usr/bin/shirudo init $SHIRUDO_INIT_ARGS

[Install]
WantedBy=sysinit.target
