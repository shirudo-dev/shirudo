[Unit]
Description=shirudo: attach XDP upatches to new network devices
After=shirudo.service
ConditionPathExists=/run/shirudo/bpffs/lsm_link
StartLimitIntervalSec=0

[Service]
Type=oneshot
SyslogIdentifier=shirudo
LimitMEMLOCK=infinity
TimeoutStartSec=2min
ExecStart=@bindir@/shirudo upatch reconcile
