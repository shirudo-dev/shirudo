[Unit]
Description=shirudo: export target status keepalive
After=shirudo.service
ConditionPathIsMountPoint=/run/shirudo/runtime

[Service]
Type=oneshot
SyslogIdentifier=shirudo
LimitMEMLOCK=infinity
TimeoutStartSec=2min
EnvironmentFile=-/etc/shirudo/map-export.env
ExecStart=/run/shirudo/runtime/usr/bin/shirudo status --otel
