[Unit]
Description=shirudo: synchronize the signed BPM upatch tree
Wants=network-online.target
After=network-online.target shirudo.service
RequiresMountsFor=/etc/shirudo/bpm /var/lib/shirudo

[Service]
Type=oneshot
SyslogIdentifier=shirudo
LimitMEMLOCK=infinity
TimeoutStartSec=30min
EnvironmentFile=-/etc/shirudo/bpm/environment
ExecStart=@bindir@/shirudo bpm tree sync
