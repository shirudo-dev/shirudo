[Unit]
Description=shirudo: export loaded upatch maps
After=shirudo.service
ConditionPathIsMountPoint=/run/shirudo/runtime
ConditionPathExists=/run/shirudo/bpffs/lsm_link

[Service]
Type=oneshot
SyslogIdentifier=shirudo
LimitMEMLOCK=infinity
TimeoutStartSec=5min
EnvironmentFile=-/etc/shirudo/map-export.env
ExecStart=/run/shirudo/runtime/usr/bin/shirudo upatch map --all
