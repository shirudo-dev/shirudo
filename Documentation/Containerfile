# The documentation toolchain: Sphinx and MyST from requirements.txt, by
# hash, on a base image pinned by digest. Builds and serves the HTML.

FROM docker.io/library/python:3.15-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --no-deps --require-hashes \
	-r /tmp/requirements.txt && rm /tmp/requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
